---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import { MapContainer } from '../../components/map/MapContainer';
import { buildClipPayloadPath } from '../../lib/clipPayload';
import { resolveFlightSchedule } from '../../lib/flightSchedules';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const itineraryLinks = headings
  .filter(heading => heading.depth === 2 && (
    heading.text === '일정 요약' || heading.text === '시간 조절 범위'
    || /^\d{1,2}\/\d{1,2}\s/.test(heading.text)
  ))
  .map(heading => ({
    href: `#${heading.slug}`,
    label: heading.text === '일정 요약' ? '일정표'
      : heading.text === '시간 조절 범위' ? '시간 조절' : heading.text.split(' · ')[0],
  }));

// 🔍 서버사이드 디버그: raw location 데이터 확인
console.log('[DEBUG] First location raw:', JSON.stringify(post.data.locations[0], null, 2));

const locations = post.data.locations.map((loc, index) => ({
  lat: loc.lat,
  lng: loc.lng,
  name: loc.name,
  order: loc.order ?? index + 1,
  note: loc.note,
  type: loc.type,
  link: loc.link,
  visitDate: loc.visitDate,
  contents: loc.contents,
  images: loc.images,
}));

const mapLocations = locations.map(l => ({
  lat: l.lat, lng: l.lng, name: l.name, order: l.order, note: l.note, type: l.type,
  link: l.link, visitDate: l.visitDate,
}));
// 여행 기간 계산
const isHiddenPost = post.data.visibility === 'hidden';
const isDraftPost = Boolean(post.data.draft);
const hasExplicitEndDate = Boolean(post.data.endDate);
const startDate = post.data.date;
const endDate = post.data.endDate || startDate;
const days = Math.ceil((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)) + 1;
const nights = post.data.nights ?? days - 1;
const durationText = days === 1 && nights === 0 ? '당일치기' : `${nights}박 ${days}일`;
const showDuration = !isHiddenPost || hasExplicitEndDate;
const durationBadgeText = showDuration ? durationText : '날짜 확인 중';
const postSlug = post.id.replace(/\.md$/, '');
const clipPayloadUrl = new URL(buildClipPayloadPath(post), Astro.url).toString();
const clipStudioUrl = new URL(import.meta.env.PUBLIC_CLIP_APP_URL || 'https://clip.dongholab.com/');
clipStudioUrl.searchParams.set('source', 'commit-map');
clipStudioUrl.searchParams.set('trip', postSlug);
clipStudioUrl.searchParams.set('clip', 'GlobeRoute');
clipStudioUrl.searchParams.set('payloadUrl', clipPayloadUrl);

// visitDate별 그룹핑
const groupedByDate = locations.reduce((acc, loc) => {
  const date = loc.visitDate || '날짜 미정';
  if (!acc[date]) acc[date] = [];
  acc[date].push(loc);
  return acc;
}, {} as Record<string, typeof locations>);

const dateGroups = Object.entries(groupedByDate);

const flights = (post.data.flights || []).map(resolveFlightSchedule);
const normalizeFlightNo = (flightNo: string) => flightNo.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
const flightAwareAirlineCodes: Record<string, string> = {
  '5J': 'CEB',
  '7C': 'JJA',
  KE: 'KAL',
  LJ: 'JNA',
};
const getFlightAwareFlightNo = (flightNo: string) => {
  const normalizedFlightNo = normalizeFlightNo(flightNo);
  const match = normalizedFlightNo.match(/^([A-Z0-9]{2})(\d.*)$/);
  if (!match) return normalizedFlightNo;

  const [, airlineCode, flightNumber] = match;
  return `${flightAwareAirlineCodes[airlineCode] || airlineCode}${flightNumber}`;
};
const getFlightAwareUrl = (flightNo: string) => (
  `https://www.flightaware.com/live/flight/${getFlightAwareFlightNo(flightNo)}`
);
const getFlightSearchUrl = (flight: typeof flights[number]) => {
  const query = [
    flight.flightNo,
    flight.date,
    flight.from && flight.to ? `${flight.from} ${flight.to}` : undefined,
  ].filter(Boolean).join(' ');

  return `https://www.google.com/search?q=${encodeURIComponent(query)}`;
};
const getFlightPrimaryUrl = (flight: typeof flights[number]) => (
  flight.lookupUrl || getFlightAwareUrl(flight.flightNo)
);
const flightDirectionLabels: Record<string, string> = {
  outbound: '출국',
  return: '귀국',
  transfer: '이동',
};

const expenses = post.data.expenses || [];
const expenseCategoryLabels: Record<string, { icon: string; label: string }> = {
  flight: { icon: '✈️', label: '항공' },
  ferry: { icon: '⛴️', label: '배편' },
  train: { icon: '🚆', label: '철도' },
  bus: { icon: '🚌', label: '버스' },
  taxi: { icon: '🚕', label: '택시' },
  'airport-transfer': { icon: '🚐', label: '공항 이동' },
  hotel: { icon: '🏨', label: '숙소' },
  food: { icon: '🍽️', label: '식사' },
  activity: { icon: '🎟️', label: '액티비티' },
  shopping: { icon: '🛍️', label: '쇼핑' },
  insurance: { icon: '🛡️', label: '보험' },
  etc: { icon: '💳', label: '기타' },
};
const formatMoney = (amount?: number, currency?: string) => {
  if (amount === undefined) return undefined;
  const targetCurrency = currency || 'KRW';

  try {
    return new Intl.NumberFormat('ko-KR', {
      style: 'currency',
      currency: targetCurrency,
      maximumFractionDigits: ['KRW', 'JPY', 'IDR'].includes(targetCurrency) ? 0 : 2,
    }).format(amount);
  } catch {
    return `${amount.toLocaleString('ko-KR')} ${targetCurrency}`;
  }
};
const getExpenseAmountText = (expense: typeof expenses[number]) => {
  const primaryAmount = formatMoney(expense.amount, expense.currency);
  const krwAmount = formatMoney(expense.krwAmount, 'KRW');

  if (primaryAmount && krwAmount && expense.currency !== 'KRW') return `${primaryAmount} · 약 ${krwAmount}`;
  return primaryAmount || krwAmount || '금액 미입력';
};
const expenseTotals = Array.from(
  expenses.reduce((totals, expense) => {
    if (expense.amount !== undefined && expense.currency) {
      totals.set(expense.currency, (totals.get(expense.currency) || 0) + expense.amount);
    }
    if (expense.krwAmount !== undefined && expense.currency !== 'KRW') {
      totals.set('KRW', (totals.get('KRW') || 0) + expense.krwAmount);
    }
    return totals;
  }, new Map<string, number>())
).map(([currency, amount]) => formatMoney(amount, currency));
---

<BaseLayout title={post.data.title} description={post.data.excerpt} noindex={isHiddenPost}>
  <article class="post">
    <header class="post-header">
      <a href="/" class="back-link">← 목록으로</a>
      <div 
        class="date-info"
        data-start={startDate.toISOString().slice(0, 10)}
        data-end={endDate.toISOString().slice(0, 10)}
      >
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.endDate && post.data.endDate.getTime() !== post.data.date.getTime() 
            ? ` ~ ${post.data.endDate.toLocaleDateString('ko-KR', { month: 'long', day: 'numeric' })}` 
            : ''}
        </time>
        <span class={`duration-badge${showDuration ? '' : ' pending-badge'}`}>{durationBadgeText}</span>
        {isDraftPost && <span class="draft-badge">작업중</span>}
        <span class="dday-badge" data-dday-badge hidden></span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.tags && (
        <div class="tags">
          {post.data.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
      {!isHiddenPost && (
        <div class="clip-actions">
          <a href={clipStudioUrl.toString()} class="clip-action" target="_blank" rel="noopener noreferrer">
            <span>영상 클립 만들기</span>
            <small>clip.dongholab.com</small>
          </a>
        </div>
      )}
    </header>

    <nav class="trip-nav" aria-label="여행 정보 바로가기">
      {itineraryLinks.map(link => <a href={link.href}>{link.label}</a>)}
      <a href="#trip-map">지도</a>
      {flights.length > 0 && <a href="#trip-flights">항공편</a>}
      {expenses.length > 0 && <a href="#trip-expenses">비용</a>}
      <a href="#trip-locations">장소</a>
    </nav>

    <section class="route-map" id="trip-map">
      <h2>🗺️ 여행 경로</h2>
      <div class="map-wrapper">
        <MapContainer client:only="react" locations={mapLocations} showRoute={true} />
      </div>
    </section>

    {flights.length > 0 && (
      <section class="flight-section" id="trip-flights">
        <h2>✈️ 항공편</h2>
        <div class="flight-grid">
          {flights.map(flight => {
            const routeText = [flight.from, flight.to].filter(Boolean).join(' → ');
            const timeText = [flight.departureTime, flight.arrivalTime].filter(Boolean).join(' → ');
            const directionLabel = flight.direction ? flightDirectionLabels[flight.direction] : undefined;

            return (
              <article class="flight-card">
                <div class="flight-card-top">
                  <div>
                    <p class="flight-label">{directionLabel || flight.airline || '항공편'}</p>
                    <h3>
                      <a href={getFlightPrimaryUrl(flight)} target="_blank" rel="noopener noreferrer">
                        {flight.flightNo}
                        <span class="link-icon">↗</span>
                      </a>
                    </h3>
                  </div>
                  {flight.date && <time datetime={flight.date}>{flight.date}</time>}
                </div>

                <div class="flight-meta">
                  {flight.airline && <span>{flight.airline}</span>}
                  {routeText && <span>{routeText}</span>}
                  {timeText && <span>{timeText}</span>}
                </div>

                {flight.note && <p class="flight-note">{flight.note}</p>}

                <div class="flight-links">
                  <a href={getFlightAwareUrl(flight.flightNo)} target="_blank" rel="noopener noreferrer">
                    FlightAware
                  </a>
                  <a href={getFlightSearchUrl(flight)} target="_blank" rel="noopener noreferrer">
                    Google 검색
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {expenses.length > 0 && (
      <section class="expense-section" id="trip-expenses">
        <div class="section-title-row">
          <h2>💳 비용 기록</h2>
          <div class="expense-totals">
            <span>{expenses.length}개 항목</span>
            {expenseTotals.map(total => total && <span>{total}</span>)}
          </div>
        </div>

        <div class="expense-grid">
          {expenses.map(expense => {
            const category = expenseCategoryLabels[expense.category] || expenseCategoryLabels.etc;
            const quantityText = expense.quantity && expense.unit
              ? `${expense.quantity}${expense.unit}`
              : undefined;

            return (
              <article class="expense-card">
                <div class="expense-card-top">
                  <div>
                    <p class="expense-category">{category.icon} {category.label}</p>
                    <h3>{expense.title}</h3>
                  </div>
                  <strong>{getExpenseAmountText(expense)}</strong>
                </div>

                <div class="expense-meta">
                  {expense.date && <span>{expense.date}</span>}
                  {quantityText && <span>{quantityText}</span>}
                  {expense.payment && <span>{expense.payment}</span>}
                  {expense.bookingSource && <span>{expense.bookingSource}</span>}
                  {expense.linkedLocation && <span>{expense.linkedLocation}</span>}
                  {expense.relatedFlightNo && <span>{expense.relatedFlightNo}</span>}
                </div>

                {expense.items && expense.items.length > 0 && (
                  <ul class="expense-items">
                    {expense.items.map(item => (
                      <li>
                        <span>{item.name}{item.quantity ? ` x ${item.quantity}` : ''}</span>
                        <strong>{formatMoney(item.amount, item.currency || expense.currency)}</strong>
                      </li>
                    ))}
                  </ul>
                )}

                {expense.note && <p class="expense-note">{expense.note}</p>}
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="post-content">
      <Content />
    </section>

    <section class="route-details" id="trip-locations">
      <h2>📍 방문 장소</h2>
      {dateGroups.map(([date, locs]) => {
        return (
          <div class="date-group">
            <div class="date-header">
              <span class="date-icon">📅</span>
              <span class="date-label">{date}</span>
            </div>
            {locs.map((loc) => (
              <div class="location-card" id={`location-${loc.order}`}>
                <div class="location-header">
                  <span class="location-number">{loc.order}</span>
                  <div class="location-title">
                    <h3>
                      {loc.link !== undefined ? (
                        <a href={loc.link === '' ? `https://www.google.com/maps/search/?api=1&query=${loc.lat},${loc.lng}` : loc.link} 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="location-link">
                          {loc.name}
                          <span class="link-icon">↗</span>
                        </a>
                      ) : (
                        loc.name
                      )}
              </h3>
              {loc.note && <p class="location-note">{loc.note}</p>}
            </div>
          </div>
          
          {loc.images && loc.images.length > 0 && (
            <div class="location-images">
              {loc.images.map(img => (
                <figure class="image-figure">
                  <img src={img.src} alt={img.alt || loc.name} loading="lazy" />
                  {img.caption && <figcaption>{img.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          
          {loc.contents && loc.contents.length > 0 && (
            <div class="location-contents">
              {loc.contents.map(content => (
                <div class="content-section">
                  {content.heading && <h4>{content.heading}</h4>}
                  <p>{content.text}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
        </div>
      );
    })}
    </section>

    {!isHiddenPost && (
      <section class="comments-section">
        <h2>💬 댓글</h2>
        <Comments />
      </section>
    )}
  </article>
</BaseLayout>

<script>
  function parseLocalDate(value: string) {
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day);
  }

  const dateInfo = document.querySelector('.date-info') as HTMLElement | null;
  const badge = document.querySelector('[data-dday-badge]') as HTMLElement | null;

  if (dateInfo && badge && dateInfo.dataset.start) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const startDate = parseLocalDate(dateInfo.dataset.start);
    const endDate = parseLocalDate(dateInfo.dataset.end || dateInfo.dataset.start);
    const dDay = Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
    const isCurrent = startDate <= today && today <= endDate;
    const isPlanned = today <= endDate;

    if (isPlanned) {
      badge.hidden = false;
      badge.textContent = isCurrent ? '여행 중' : (dDay === 0 ? 'D-Day!' : `D-${dDay}`);
    }
  }

  const renderMermaidDiagrams = async () => {
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.post-content pre[data-language="mermaid"] > code, .post-content pre > code.language-mermaid'
      )
    );
    if (blocks.length === 0) return;

    const { default: mermaid } = await import(
      /* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/mermaid@11.12.1/dist/mermaid.esm.min.mjs'
    );

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      themeVariables: {
        primaryColor: '#eef2ff',
        primaryTextColor: '#1e293b',
        primaryBorderColor: '#4361ee',
        lineColor: '#64748b',
        secondaryColor: '#ecfdf5',
        tertiaryColor: '#fff7ed',
        fontFamily: 'Noto Sans KR, system-ui, sans-serif',
      },
    });

    for (const [index, block] of blocks.entries()) {
      const pre = block.parentElement;
      const source = block.textContent?.trim();
      if (!pre || !source) continue;

      const diagram = document.createElement('div');
      diagram.className = 'mermaid-diagram';
      diagram.setAttribute('role', 'img');

      try {
        const { svg } = await mermaid.render(`post-mermaid-${index}-${Date.now()}`, source);
        diagram.innerHTML = svg;
        pre.replaceWith(diagram);
      } catch {
        pre.classList.add('mermaid-error');
      }
    }
  };

  renderMermaidDiagrams();
</script>

<style>
  .trip-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }

  .trip-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-secondary);
    color: var(--color-primary);
    font-weight: 600;
  }

  .trip-nav a:hover,
  .trip-nav a:focus-visible {
    border-color: var(--color-primary);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  section[id],
  .post-content :global(h2[id]) {
    scroll-margin-top: 90px;
  }

  .post {
    max-width: 900px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .post-header time {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .date-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .duration-badge {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .duration-badge.pending-badge {
    background: linear-gradient(135deg, #64748b, #475569);
  }

  .draft-badge {
    display: inline-flex;
    align-items: center;
    min-height: 23px;
    padding: 0.15rem 0.5rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #e2e8f0;
    color: #475569;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .dday-badge {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    animation: pulse 2s infinite;
  }

  .dday-badge-small {
    background: #fef3c7;
    color: #d97706;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .date-group {
    margin-bottom: 1.5rem;
  }

  .date-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #4361ee15, #7b2cbf15);
    border-radius: 8px;
    margin-bottom: 1rem;
    border-left: 4px solid var(--color-primary);
  }

  .date-icon {
    font-size: 1.25rem;
  }

  .date-label {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 1rem;
  }

  .post-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #4361ee, #7b2cbf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(123, 44, 191, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .clip-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .clip-action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgba(67, 97, 238, 0.22);
    border-radius: 8px;
    background: rgba(67, 97, 238, 0.07);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.75rem 0.9rem;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .clip-action small {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .clip-action:hover {
    background: rgba(67, 97, 238, 0.12);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .route-map,
  .flight-section,
  .expense-section {
    margin-bottom: 2rem;
  }

  .route-map h2, .route-details h2, .flight-section h2, .expense-section h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .map-wrapper {
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
  }

  .flight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .flight-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .flight-card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .flight-label {
    color: var(--color-text-muted);
    font-size: 0.78rem;
