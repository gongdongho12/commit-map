---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import { MapContainer } from '../../components/map/MapContainer';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 🔍 서버사이드 디버그: raw location 데이터 확인
console.log('[DEBUG] First location raw:', JSON.stringify(post.data.locations[0], null, 2));

const locations = post.data.locations.map((loc, index) => ({
  lat: loc.lat,
  lng: loc.lng,
  name: loc.name,
  order: loc.order ?? index + 1,
  note: loc.note,
  type: loc.type,
  link: loc.link,
  visitDate: loc.visitDate,
  contents: loc.contents,
  images: loc.images,
}));

const mapLocations = locations.map(l => ({
  lat: l.lat, lng: l.lng, name: l.name, order: l.order, note: l.note, type: l.type,
  link: l.link, visitDate: l.visitDate,
}));
// 여행 기간 계산
const startDate = post.data.date;
const endDate = post.data.endDate || startDate;
const days = Math.ceil((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)) + 1;
const nights = days - 1;
const durationText = nights > 0 ? `${nights}박 ${days}일` : '당일치기';

// visitDate별 그룹핑
const groupedByDate = locations.reduce((acc, loc) => {
  const date = loc.visitDate || '날짜 미정';
  if (!acc[date]) acc[date] = [];
  acc[date].push(loc);
  return acc;
}, {} as Record<string, typeof locations>);

const dateGroups = Object.entries(groupedByDate);

const flights = post.data.flights || [];
const normalizeFlightNo = (flightNo: string) => flightNo.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
const getFlightAwareUrl = (flightNo: string) => (
  `https://www.flightaware.com/live/flight/${normalizeFlightNo(flightNo)}`
);
const getFlightSearchUrl = (flight: typeof flights[number]) => {
  const query = [
    flight.flightNo,
    flight.date,
    flight.from && flight.to ? `${flight.from} ${flight.to}` : undefined,
  ].filter(Boolean).join(' ');

  return `https://www.google.com/search?q=${encodeURIComponent(query)}`;
};
const getFlightPrimaryUrl = (flight: typeof flights[number]) => (
  flight.lookupUrl || getFlightAwareUrl(flight.flightNo)
);
const flightDirectionLabels: Record<string, string> = {
  outbound: '출국',
  return: '귀국',
  transfer: '이동',
};
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="post">
    <header class="post-header">
      <a href="/" class="back-link">← 목록으로</a>
      <div 
        class="date-info"
        data-start={startDate.toISOString().slice(0, 10)}
        data-end={endDate.toISOString().slice(0, 10)}
      >
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.endDate && post.data.endDate.getTime() !== post.data.date.getTime() 
            ? ` ~ ${post.data.endDate.toLocaleDateString('ko-KR', { month: 'long', day: 'numeric' })}` 
            : ''}
        </time>
        <span class="duration-badge">{durationText}</span>
        <span class="dday-badge" data-dday-badge hidden></span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.tags && (
        <div class="tags">
          {post.data.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <section class="route-map">
      <h2>🗺️ 여행 경로</h2>
      <div class="map-wrapper">
        <MapContainer client:only="react" locations={mapLocations} showRoute={true} />
      </div>
    </section>

    {flights.length > 0 && (
      <section class="flight-section">
        <h2>✈️ 항공편</h2>
        <div class="flight-grid">
          {flights.map(flight => {
            const routeText = [flight.from, flight.to].filter(Boolean).join(' → ');
            const timeText = [flight.departureTime, flight.arrivalTime].filter(Boolean).join(' → ');
            const directionLabel = flight.direction ? flightDirectionLabels[flight.direction] : undefined;

            return (
              <article class="flight-card">
                <div class="flight-card-top">
                  <div>
                    <p class="flight-label">{directionLabel || flight.airline || '항공편'}</p>
                    <h3>
                      <a href={getFlightPrimaryUrl(flight)} target="_blank" rel="noopener noreferrer">
                        {flight.flightNo}
                        <span class="link-icon">↗</span>
                      </a>
                    </h3>
                  </div>
                  {flight.date && <time datetime={flight.date}>{flight.date}</time>}
                </div>

                <div class="flight-meta">
                  {flight.airline && <span>{flight.airline}</span>}
                  {routeText && <span>{routeText}</span>}
                  {timeText && <span>{timeText}</span>}
                </div>

                {flight.note && <p class="flight-note">{flight.note}</p>}

                <div class="flight-links">
                  <a href={getFlightAwareUrl(flight.flightNo)} target="_blank" rel="noopener noreferrer">
                    FlightAware
                  </a>
                  <a href={getFlightSearchUrl(flight)} target="_blank" rel="noopener noreferrer">
                    Google 검색
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="route-details">
      <h2>📍 방문 장소</h2>
      {dateGroups.map(([date, locs]) => {
        return (
          <div class="date-group">
            <div class="date-header">
              <span class="date-icon">📅</span>
              <span class="date-label">{date}</span>
            </div>
            {locs.map((loc) => (
              <div class="location-card" id={`location-${loc.order}`}>
                <div class="location-header">
                  <span class="location-number">{loc.order}</span>
                  <div class="location-title">
                    <h3>
                      {loc.link !== undefined ? (
                        <a href={loc.link === '' ? `https://www.google.com/maps/search/?api=1&query=${loc.lat},${loc.lng}` : loc.link} 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="location-link">
                          {loc.name}
                          <span class="link-icon">↗</span>
                        </a>
                      ) : (
                        loc.name
                      )}
              </h3>
              {loc.note && <p class="location-note">{loc.note}</p>}
            </div>
          </div>
          
          {loc.images && loc.images.length > 0 && (
            <div class="location-images">
              {loc.images.map(img => (
                <figure class="image-figure">
                  <img src={img.src} alt={img.alt || loc.name} loading="lazy" />
                  {img.caption && <figcaption>{img.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          
          {loc.contents && loc.contents.length > 0 && (
            <div class="location-contents">
              {loc.contents.map(content => (
                <div class="content-section">
                  {content.heading && <h4>{content.heading}</h4>}
                  <p>{content.text}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
        </div>
      );
    })}
    </section>

    <section class="post-content">
      <Content />
    </section>

    <section class="comments-section">
      <h2>💬 댓글</h2>
      <Comments />
    </section>
  </article>
</BaseLayout>

<script>
  function parseLocalDate(value: string) {
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day);
  }

  const dateInfo = document.querySelector('.date-info') as HTMLElement | null;
  const badge = document.querySelector('[data-dday-badge]') as HTMLElement | null;

  if (dateInfo && badge && dateInfo.dataset.start) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const startDate = parseLocalDate(dateInfo.dataset.start);
    const endDate = parseLocalDate(dateInfo.dataset.end || dateInfo.dataset.start);
    const dDay = Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
    const isCurrent = startDate <= today && today <= endDate;
    const isPlanned = today <= endDate;

    if (isPlanned) {
      badge.hidden = false;
      badge.textContent = isCurrent ? '여행 중' : (dDay === 0 ? 'D-Day!' : `D-${dDay}`);
    }
  }
</script>

<style>
  .post {
    max-width: 900px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .post-header time {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .date-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .duration-badge {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .dday-badge {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    animation: pulse 2s infinite;
  }

  .dday-badge-small {
    background: #fef3c7;
    color: #d97706;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .date-group {
    margin-bottom: 1.5rem;
  }

  .date-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #4361ee15, #7b2cbf15);
    border-radius: 8px;
    margin-bottom: 1rem;
    border-left: 4px solid var(--color-primary);
  }

  .date-icon {
    font-size: 1.25rem;
  }

  .date-label {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 1rem;
  }

  .post-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #4361ee, #7b2cbf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(123, 44, 191, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .route-map,
  .flight-section {
    margin-bottom: 2rem;
  }

  .route-map h2, .route-details h2, .flight-section h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .map-wrapper {
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
  }

  .flight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .flight-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .flight-card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .flight-label {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .flight-card h3 {
    font-size: 1.3rem;
    line-height: 1.2;
    margin: 0;
  }

  .flight-card h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-primary);
  }

  .flight-card time {
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: right;
  }

  .flight-meta,
  .flight-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .flight-meta {
    margin-bottom: 0.85rem;
  }

  .flight-meta span {
    background: #f1f5f9;
    border-radius: 4px;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.28rem 0.5rem;
  }

  .flight-note {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0 0 0.85rem;
  }

  .flight-links a {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.35rem 0.55rem;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .flight-links a:hover {
    background: rgba(67, 97, 238, 0.08);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .route-details {
    margin-bottom: 3rem;
  }

  .location-card {
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-border);
  }

  .location-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .location-number {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #4361ee, #7b2cbf);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 14px;
  }

  .location-title h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .location-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .location-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .image-figure {
    margin: 0;
  }

  .image-figure img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
    background: #f1f5f9;
  }

  .image-figure figcaption {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
  }

  .location-contents {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .content-section {
    background: #f8fafc;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border-left: 3px solid var(--color-primary);
  }

  .content-section h4 {
    font-size: 0.875rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .content-section p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .post-content {
    line-height: 1.8;
    margin-bottom: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .post-content :global(p) { margin-bottom: 1rem; }

  .comments-section {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .comments-section h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .giscus-note {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
    padding: 1rem;
    background: var(--color-bg-secondary);
    border-radius: 8px;
  }

  .giscus-note a {
    color: var(--color-primary);
  }

  .location-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .location-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .link-icon {
    font-size: 0.8em;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .location-link:hover .link-icon {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .post {
      max-width: 100%;
    }

    .post-header {
      margin-bottom: 1.5rem;
    }

    .back-link {
      margin-bottom: 0.75rem;
    }

    .date-info {
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .post-header time {
      width: 100%;
      line-height: 1.5;
    }

    .post-header h1 {
      font-size: 1.6rem;
      line-height: 1.3;
      margin-bottom: 0.75rem;
    }

    .tags {
      gap: 0.375rem;
    }

    .route-map,
    .flight-section {
      margin-bottom: 1.5rem;
    }

    .route-map h2, .route-details h2, .flight-section h2, .comments-section h2 {
      font-size: 1.1rem;
    }

    .map-wrapper {
      height: 320px;
      border-radius: 10px;
    }

    .flight-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .flight-card {
      padding: 1rem;
      border-radius: 10px;
    }

    .flight-card-top {
      align-items: flex-start;
      margin-bottom: 0.75rem;
    }

    .flight-card h3 {
      font-size: 1.15rem;
    }

    .date-header {
      padding: 0.65rem 0.85rem;
      border-radius: 8px;
    }

    .location-card {
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 10px;
    }

    .location-header {
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .location-number {
      width: 32px;
      height: 32px;
      font-size: 13px;
    }

    .location-title {
      min-width: 0;
    }

    .location-title h3 {
      font-size: 1.05rem;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .location-note {
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .location-images {
      grid-template-columns: 1fr;
    }

    .content-section {
      padding: 0.75rem;
      border-radius: 8px;
    }

    .content-section p {
      font-size: 0.875rem;
    }

    .post-content {
      padding-top: 1.5rem;
      margin-bottom: 2rem;
      line-height: 1.75;
      overflow-wrap: anywhere;
    }

    .post-content :global(h1) {
      font-size: 1.45rem;
    }

    .post-content :global(h2) {
      font-size: 1.25rem;
    }

    .post-content :global(h3) {
      font-size: 1.1rem;
    }

    .post-content :global(table) {
      display: block;
      width: 100%;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
      padding-left: 1.25rem;
    }
  }

  @media (max-width: 420px) {
    .post-header h1 {
      font-size: 1.4rem;
    }

    .map-wrapper {
      height: 280px;
    }

    .location-card {
      padding: 0.875rem;
    }
  }
</style>
