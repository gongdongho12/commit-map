---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import { getCollection, render } from 'astro:content';
import Comments from '../../../components/Comments.astro';
import { MapContainer } from '../../../components/map/MapContainer';
import { buildClipPayloadPath } from '../../../lib/clipPayload';
import { localizeFlightAirline, resolveFlightSchedule } from '../../../lib/flightSchedules';
import { getTripMapLocations } from '../../../lib/tripMapLocations';
import { localizePostData } from '../../../lib/postTranslations';
import { homeText, homePaths, homeLocales, HOME_LANGUAGES, type HomeLanguage } from '../../../lib/homeLanguages';
import LanguagePreferenceRedirect from '../../../components/LanguagePreferenceRedirect.astro';

export async function getStaticPaths() {
  const [posts, translations] = await Promise.all([getCollection('posts'), getCollection('postTranslations')]);
  const byKey = new Map(translations.map(entry => [`${entry.data.postSlug}:${entry.data.lang}`, entry]));
  if (byKey.size !== translations.length) throw new Error('Duplicate post translation language');
  const postSlugs = new Set(posts.map(post => post.id.replace(/\.md$/, '')));
  for (const entry of translations) {
    if (!postSlugs.has(entry.data.postSlug)) throw new Error(`Translation has no original post: ${entry.data.postSlug}`);
  }
  return posts.flatMap(post => {
    const slug = post.id.replace(/\.md$/, '');
    const legacyEnglish = /class=["'][^"']*\blang-en\b|(?:^|\n)\s*(?:[-*>]\s*)*(?:\*\*)?(?:EN\s*:|\[EN\]|\(EN\))/im.test(post.body);
    const availableLanguages = HOME_LANGUAGES.filter(lang => lang === 'ko' || byKey.has(`${slug}:${lang}`) || (lang === 'en' && legacyEnglish));
    const languagePaths = availableLanguages.map(lang => {
      const translation = byKey.get(`${slug}:${lang}`);
      if (translation) localizePostData(post.data, translation.data);
      return {
        params: { slug, lang },
        props: { post, translation, initialLang: lang, availableLanguages },
      };
    });
    return [
      { params: { slug, lang: undefined }, props: { post, initialLang: byKey.has(`${slug}:en`) ? 'ko' : 'all', availableLanguages } },
      ...languagePaths,
    ];
  });
}

const { post: originalPost, translation, initialLang, availableLanguages } = Astro.props;
const lang: HomeLanguage = initialLang === 'all' ? 'ko' : initialLang;
const isTranslated = lang !== 'ko';
const displayMode = initialLang === 'all' ? 'all' : isTranslated ? 'en' : 'ko';
const hasEnglish = availableLanguages.includes('en');
const post = {
  ...originalPost,
  data: isTranslated && translation ? localizePostData(originalPost.data, translation.data) : originalPost.data,
};
const { Content, headings } = await render(isTranslated && translation ? translation : originalPost);
const locale = homeLocales[lang];
const text = (ko: string, en: string) => homeText(lang, ko, en);
const label = (en: string) => lang === 'ja' || lang === 'zh' ? homeText(lang, '', en) : en;
const dayOfWeekEnMap: Record<string, string> = {
  '월': 'Mon', '화': 'Tue', '수': 'Wed', '목': 'Thu', '금': 'Fri', '토': 'Sat', '일': 'Sun'
};

const formatItineraryLabel = (text: string) => {
  if (text.includes('일정 요약') || text.includes('Trip Summary') || text.includes('旅程の概要') || text.includes('行程概要')) {
    return { ko: '일정표', en: 'Summary' };
  }
  if (text.includes('투어 후보 비교') || text.includes('Tour Comparison')) {
    return { ko: '투어 비교', en: 'Tours' };
  }
  if (text.includes('시간 조절 범위') || text.includes('Flexible Time')) {
    return { ko: '시간 조절', en: 'Schedule' };
  }
  const dateMatch = text.match(/^(\d{1,2}\/\d{1,2})\s*\(([월화수목금토일])\)/);
  if (dateMatch) {
    const [, date, day] = dateMatch;
    const dayEn = dayOfWeekEnMap[day] || day;
    return { ko: `${date} (${day})`, en: `${date} (${dayEn})` };
  }
  const raw = text.split(' · ')[0];
  return { ko: raw, en: raw };
};

const itineraryLinks = headings
  .filter(heading => heading.depth === 2 && (
    heading.text.includes('일정 요약') || heading.text.includes('Trip Summary') || heading.text.includes('旅程の概要') || heading.text.includes('行程概要')
    || heading.text.includes('투어 후보 비교')
    || heading.text.includes('시간 조절 범위')
    || /^\d{1,2}\/\d{1,2}\s/.test(heading.text)
  ))
  .map(heading => {
    const labels = formatItineraryLabel(heading.text);
    return {
      href: `#${heading.slug}`,
      labelKo: labels.ko,
      labelEn: labels.en,
    };
  });


const locations = post.data.locations.map((loc, index) => ({
  lat: loc.lat,
  lng: loc.lng,
  name: loc.name,
  order: loc.order ?? index + 1,
  note: loc.note,
  type: loc.type,
  link: loc.link,
  visitDate: loc.visitDate,
  contents: loc.contents,
  images: loc.images,
}));

// Filter using original records so translated airport names cannot change route geometry.
const sharedMapStops = new Set(getTripMapLocations(originalPost.data.locations, {
  ...originalPost.data, flights: (originalPost.data.flights || []).map(resolveFlightSchedule),
}));
const mapLocations = locations.filter((_, index) => sharedMapStops.has(originalPost.data.locations[index])).map(l => ({
  lat: l.lat, lng: l.lng, name: l.name, order: l.order, note: l.note, type: l.type,
  link: l.link, visitDate: l.visitDate,
}));
// 여행 기간 계산
const isHiddenPost = post.data.visibility === 'hidden';
const isDraftPost = Boolean(post.data.draft);
const hasExplicitEndDate = Boolean(post.data.endDate);
const startDate = post.data.date;
const endDate = post.data.endDate || startDate;
const days = Math.ceil((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)) + 1;
const nights = post.data.nights ?? days - 1;
const durationText = days === 1 && nights === 0 ? '당일치기' : `${nights}박 ${days}일`;
const showDuration = !isHiddenPost || hasExplicitEndDate;
const durationBadgeText = showDuration ? durationText : '날짜 확인 중';
const postSlug = post.id.replace(/\.md$/, '');
const clipPayloadUrl = new URL(buildClipPayloadPath(post), Astro.url).toString();
const clipStudioUrl = new URL(import.meta.env.PUBLIC_CLIP_APP_URL || 'https://clip.dongholab.com/');
clipStudioUrl.searchParams.set('source', 'commit-map');
clipStudioUrl.searchParams.set('trip', postSlug);
clipStudioUrl.searchParams.set('clip', 'GlobeRoute');
clipStudioUrl.searchParams.set('payloadUrl', clipPayloadUrl);

// visitDate별 그룹핑
const groupedByDate = locations.reduce((acc, loc) => {
  const date = loc.visitDate || text('날짜 미정', 'Date pending');
  if (!acc[date]) acc[date] = [];
  acc[date].push(loc);
  return acc;
}, {} as Record<string, typeof locations>);

const dateGroups = Object.entries(groupedByDate);

const flights = (post.data.flights || []).map(flight => localizeFlightAirline(resolveFlightSchedule(flight), isTranslated ? 'en' : 'ko'));
const normalizeFlightNo = (flightNo: string) => flightNo.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
const flightAwareAirlineCodes: Record<string, string> = {
  '5J': 'CEB',
  '7C': 'JJA',
  KE: 'KAL',
  LJ: 'JNA',
};
const getFlightAwareFlightNo = (flightNo: string) => {
  const normalizedFlightNo = normalizeFlightNo(flightNo);
  const match = normalizedFlightNo.match(/^([A-Z0-9]{2})(\d.*)$/);
  if (!match) return normalizedFlightNo;

  const [, airlineCode, flightNumber] = match;
  return `${flightAwareAirlineCodes[airlineCode] || airlineCode}${flightNumber}`;
};
const getFlightAwareUrl = (flightNo: string) => (
  `https://www.flightaware.com/live/flight/${getFlightAwareFlightNo(flightNo)}`
);
const getFlightSearchUrl = (flight: typeof flights[number]) => {
  const query = [
    flight.flightNo,
    flight.date,
    flight.from && flight.to ? `${flight.from} ${flight.to}` : undefined,
  ].filter(Boolean).join(' ');

  return `https://www.google.com/search?q=${encodeURIComponent(query)}`;
};
const getFlightPrimaryUrl = (flight: typeof flights[number]) => (
  flight.lookupUrl || getFlightAwareUrl(flight.flightNo)
);
const flightDirectionLabels: Record<string, string> = {
  outbound: text('출국', 'Outbound'),
  return: text('귀국', 'Return'),
  transfer: text('이동', 'Transfer'),
};

const expenses = post.data.expenses || [];
const expenseCategoryLabels: Record<string, { icon: string; label: string }> = {
  flight: { icon: '✈️', label: text('항공', 'Flight') },
  ferry: { icon: '⛴️', label: text('배편', 'Ferry') },
  train: { icon: '🚆', label: text('철도', 'Train') },
  bus: { icon: '🚌', label: text('버스', 'Bus') },
  taxi: { icon: '🚕', label: text('택시', 'Taxi') },
  'airport-transfer': { icon: '🚐', label: text('공항 이동', 'Airport transfer') },
  hotel: { icon: '🏨', label: text('숙소', 'Hotel') },
  food: { icon: '🍽️', label: text('식사', 'Food') },
  activity: { icon: '🎟️', label: text('액티비티', 'Activity') },
  shopping: { icon: '🛍️', label: text('쇼핑', 'Shopping') },
  insurance: { icon: '🛡️', label: text('보험', 'Insurance') },
  etc: { icon: '💳', label: text('기타', 'Other') },
};
const formatMoney = (amount?: number, currency?: string) => {
  if (amount === undefined) return undefined;
  const targetCurrency = currency || 'KRW';

  try {
    return new Intl.NumberFormat(locale, {
      style: 'currency',
      currency: targetCurrency,
      maximumFractionDigits: ['KRW', 'JPY', 'IDR'].includes(targetCurrency) ? 0 : 2,
    }).format(amount);
  } catch {
    return `${amount.toLocaleString(locale)} ${targetCurrency}`;
  }
};
const getExpenseAmountText = (expense: typeof expenses[number]) => {
  const primaryAmount = formatMoney(expense.amount, expense.currency);
  const krwAmount = formatMoney(expense.krwAmount, 'KRW');

  if (primaryAmount && krwAmount && expense.currency !== 'KRW') return `${primaryAmount} · ${text('약', 'approx.')} ${krwAmount}`;
  return primaryAmount || krwAmount || text('금액 미입력', 'Amount pending');
};
const expenseTotals = Array.from(
  expenses.reduce((totals, expense) => {
    if (expense.amount !== undefined && expense.currency) {
      totals.set(expense.currency, (totals.get(expense.currency) || 0) + expense.amount);
    }
    if (expense.krwAmount !== undefined && expense.currency !== 'KRW') {
      totals.set('KRW', (totals.get('KRW') || 0) + expense.krwAmount);
    }
    return totals;
  }, new Map<string, number>())
).map(([currency, amount]) => formatMoney(amount, currency));
---

<BaseLayout title={isTranslated ? (translation?.data.title || post.data.titleEn || post.data.title) : post.data.title} description={post.data.excerpt} noindex={isHiddenPost} lang={lang}>
  <Fragment slot="head">{!Astro.params.lang && <LanguagePreferenceRedirect postSlug={postSlug} />}</Fragment>
  <LanguageSwitcher slot="header-actions" postSlug={postSlug} currentLang={initialLang} hasEnglish={hasEnglish} hasTranslation={Boolean(translation) || initialLang !== 'all'} availableLanguages={availableLanguages} />
  <script is:inline define:vars={{ pageLang: displayMode }}>
    document.documentElement.setAttribute('data-lang-mode', pageLang);
  </script>
  <article class={`post mode-${displayMode}`} data-post-slug={postSlug} data-initial-lang={initialLang} data-display-mode={displayMode}>
    <header class="post-header">
      <a href={homePaths[lang]} class="back-link">
        <span class="lang-ko">← 목록으로</span>
        <span class="lang-en">{label("← Back to Trips")}</span>
      </a>
      <div 
        class="date-info"
        data-start={startDate.toISOString().slice(0, 10)}
        data-end={endDate.toISOString().slice(0, 10)}
      >
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.endDate && post.data.endDate.getTime() !== post.data.date.getTime() 
            ? ` ~ ${post.data.endDate.toLocaleDateString(locale, { month: 'long', day: 'numeric' })}`
            : ''}
        </time>
        <span class={`duration-badge${showDuration ? '' : ' pending-badge'}`}>
          <span class="lang-ko">{durationBadgeText}</span>
          <span class="lang-en">{showDuration ? (days === 1 && nights === 0 ? label('Day Trip') : lang === 'ja' ? `${nights}泊${days}日` : lang === 'zh' ? `${nights}晚${days}天` : `${nights}N ${days}D`) : label('Pending')}</span>
        </span>
        {isDraftPost && <span class="draft-badge"><span class="lang-ko">작업중</span><span class="lang-en">{label("Draft")}</span></span>}
        <span class="dday-badge" data-dday-badge hidden></span>
      </div>
      <h1>
        <span class="lang-ko">{post.data.title}</span>
        <span class="lang-en">{translation?.data.title || post.data.titleEn || post.data.title}</span>
      </h1>
      {post.data.tags && (
        <div class="tags">
          {post.data.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
      {!isHiddenPost && (
        <div class="clip-actions">
          <a href={clipStudioUrl.toString()} class="clip-action" target="_blank" rel="noopener noreferrer">
            <span>{text('영상 클립 만들기', 'Create a video clip')}</span>
            <small>clip.dongholab.com</small>
          </a>
        </div>
      )}
    </header>

    <nav class="trip-nav" aria-label={text('여행 정보 바로가기', 'Trip sections')}>
      {itineraryLinks.map(link => (
        <a href={link.href}>
          <span class="lang-ko">{link.labelKo}</span>
          <span class="lang-en">{label(link.labelEn)}</span>
        </a>
      ))}
      <a href="#trip-map"><span class="lang-ko">지도</span><span class="lang-en">{label("Map")}</span></a>
      {flights.length > 0 && <a href="#trip-flights"><span class="lang-ko">항공편</span><span class="lang-en">{label("Flights")}</span></a>}
      {expenses.length > 0 && <a href="#trip-expenses"><span class="lang-ko">비용</span><span class="lang-en">{label("Expenses")}</span></a>}
      <a href="#trip-locations"><span class="lang-ko">장소</span><span class="lang-en">{label("Locations")}</span></a>
    </nav>

    <section class="route-map" id="trip-map">
      <h2>🗺️ <span class="lang-ko">여행 경로</span><span class="lang-en">{label("Trip Route Map")}</span></h2>
      <div class="map-wrapper">
        <MapContainer client:only="react" locations={mapLocations} showRoute={true} lang={lang} />
      </div>
    </section>

    {flights.length > 0 && (
      <section class="flight-section" id="trip-flights">
        <h2>✈️ <span class="lang-ko">항공편</span><span class="lang-en">{label("Flights")}</span></h2>
        <div class="flight-grid">
          {flights.map(flight => {
            const routeText = [flight.from, flight.to].filter(Boolean).join(' → ');
            const timeText = [flight.departureTime, flight.arrivalTime].filter(Boolean).join(' → ');
            const directionLabel = flight.direction ? flightDirectionLabels[flight.direction] : undefined;

            return (
              <article class="flight-card">
                <div class="flight-card-top">
                  <div>
                    <p class="flight-label">{directionLabel || flight.airline || text('항공편', 'Flight')}</p>
                    <h3>
                      <a href={getFlightPrimaryUrl(flight)} target="_blank" rel="noopener noreferrer">
                        {flight.flightNo}
                        <span class="link-icon">↗</span>
                      </a>
                    </h3>
                  </div>
                  {flight.date && <time datetime={flight.date}>{flight.date}</time>}
                </div>

                <div class="flight-meta">
                  {flight.airline && <span>{flight.airline}</span>}
                  {routeText && <span>{routeText}</span>}
                  {timeText && <span>{timeText}</span>}
                </div>

                {flight.note && <p class="flight-note">{flight.note}</p>}

                <div class="flight-links">
                  <a href={getFlightAwareUrl(flight.flightNo)} target="_blank" rel="noopener noreferrer">
                    FlightAware
                  </a>
                  <a href={getFlightSearchUrl(flight)} target="_blank" rel="noopener noreferrer">
                    {text('Google 검색', 'Google search')}
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {expenses.length > 0 && (
      <section class="expense-section" id="trip-expenses">
        <div class="section-title-row">
          <h2>💳 <span class="lang-ko">비용 기록</span><span class="lang-en">{label("Trip Expenses")}</span></h2>
          <div class="expense-totals">
            <span>{expenses.length}{text('개 항목', ' items')}</span>
            {expenseTotals.map(total => total && <span>{total}</span>)}
          </div>
        </div>

        <div class="expense-grid">
          {expenses.map(expense => {
            const category = expenseCategoryLabels[expense.category] || expenseCategoryLabels.etc;
            const quantityText = expense.quantity && expense.unit
              ? `${expense.quantity}${expense.unit}`
              : undefined;

            return (
              <article class="expense-card">
                <div class="expense-card-top">
                  <div>
                    <p class="expense-category">{category.icon} {category.label}</p>
                    <h3>{expense.title}</h3>
                  </div>
                  <strong>{getExpenseAmountText(expense)}</strong>
                </div>

                <div class="expense-meta">
                  {expense.date && <span>{expense.date}</span>}
                  {quantityText && <span>{quantityText}</span>}
                  {expense.payment && <span>{expense.payment}</span>}
                  {expense.bookingSource && <span>{expense.bookingSource}</span>}
                  {expense.linkedLocation && <span>{expense.linkedLocation}</span>}
                  {expense.relatedFlightNo && <span>{expense.relatedFlightNo}</span>}
                </div>

                {expense.items && expense.items.length > 0 && (
                  <ul class="expense-items">
                    {expense.items.map(item => (
                      <li>
                        <span>{item.name}{item.quantity ? ` x ${item.quantity}` : ''}</span>
                        <strong>{formatMoney(item.amount, item.currency || expense.currency)}</strong>
                      </li>
                    ))}
                  </ul>
                )}

                {expense.note && <p class="expense-note">{expense.note}</p>}
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="post-content">
      <Content />
    </section>

    <section class="route-details" id="trip-locations">
      <h2>📍 <span class="lang-ko">방문 장소</span><span class="lang-en">{label("Visited Places")}</span></h2>
      {dateGroups.map(([date, locs]) => {
        return (
          <div class="date-group">
            <div class="date-header">
              <span class="date-icon">📅</span>
              <span class="date-label">{date}</span>
            </div>
            {locs.map((loc) => (
              <div class="location-card" id={`location-${loc.order}`}>
                <div class="location-header">
                  <span class="location-number">{loc.order}</span>
                  <div class="location-title">
                    <h3>
                      {loc.link !== undefined ? (
                        <a href={loc.link === '' ? `https://www.google.com/maps/search/?api=1&query=${loc.lat},${loc.lng}` : loc.link} 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="location-link">
                          {loc.name}
                          <span class="link-icon">↗</span>
                        </a>
                      ) : (
                        loc.name
                      )}
              </h3>
              {loc.note && <p class="location-note">{loc.note}</p>}
            </div>
          </div>
          
          {loc.images && loc.images.length > 0 && (
            <div class="location-images">
              {loc.images.map(img => (
                <figure class="image-figure">
                  <img src={img.src} alt={img.alt || loc.name} loading="lazy" />
                  {img.caption && <figcaption>{img.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          
          {loc.contents && loc.contents.length > 0 && (
            <div class="location-contents">
              {loc.contents.map(content => (
                <div class="content-section">
                  {content.heading && <h4>{content.heading}</h4>}
                  <p>{content.text}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
        </div>
      );
    })}
    </section>

    {!isHiddenPost && (
      <section class="comments-section">
        <h2>💬 <span class="lang-ko">댓글</span><span class="lang-en">{label("Comments")}</span></h2>
        <Comments lang={lang} term={`posts/${postSlug}/`} />
      </section>
    )}
  </article>
</BaseLayout>

<script>
  function parseLocalDate(value: string) {
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day);
  }

  const dateInfo = document.querySelector('.date-info') as HTMLElement | null;
  const badge = document.querySelector('[data-dday-badge]') as HTMLElement | null;

  if (dateInfo && badge && dateInfo.dataset.start) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const startDate = parseLocalDate(dateInfo.dataset.start);
    const endDate = parseLocalDate(dateInfo.dataset.end || dateInfo.dataset.start);
    const dDay = Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
    const isCurrent = startDate <= today && today <= endDate;
    const isPlanned = today <= endDate;

    if (isPlanned) {
      badge.hidden = false;
      badge.textContent = isCurrent ? (document.documentElement.lang === 'ja' ? '旅行中' : document.documentElement.lang === 'zh' ? '旅行中' : document.documentElement.lang === 'en' ? 'Traveling' : '여행 중') : (dDay === 0 ? 'D-Day!' : `D-${dDay}`);
    }
  }

  const renderMermaidDiagrams = async () => {
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.post-content pre[data-language="mermaid"] > code, .post-content pre > code.language-mermaid'
      )
    );
    if (blocks.length === 0) return;

    const { default: mermaid } = await import(
      /* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/mermaid@11.12.1/dist/mermaid.esm.min.mjs'
    );

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      themeVariables: {
        primaryColor: '#eef2ff',
        primaryTextColor: '#1e293b',
        primaryBorderColor: '#4361ee',
        lineColor: '#64748b',
        secondaryColor: '#ecfdf5',
        tertiaryColor: '#fff7ed',
        fontFamily: getComputedStyle(document.documentElement).fontFamily || 'Noto Sans KR, system-ui, sans-serif',
      },
    });

    for (const [index, block] of blocks.entries()) {
      const pre = block.parentElement;
      const source = block.textContent?.trim();
      if (!pre || !source) continue;

      const diagram = document.createElement('div');
      diagram.className = 'mermaid-diagram';
      diagram.setAttribute('role', 'img');

      try {
        const { svg } = await mermaid.render(`post-mermaid-${index}-${Date.now()}`, source);
        diagram.innerHTML = svg;
        pre.replaceWith(diagram);
      } catch {
        pre.classList.add('mermaid-error');
      }
    }
  };

  renderMermaidDiagrams();

  const initLanguageSwitcher = () => {
    const postArticle = document.querySelector<HTMLElement>('.post');
    const postContent = document.querySelector<HTMLElement>('.post-content');
    if (!postArticle || !postContent) return;

    // Scan for legacy KO: / EN: tags if any
    const candidates = Array.from(postContent.querySelectorAll<HTMLElement>('li, p, div, h2, h3, h4, blockquote'));
    candidates.forEach((el) => {
      const text = el.textContent?.trim() || '';
      const strong = el.querySelector('strong');
      const strongText = strong?.textContent?.trim() || '';
      if (/^(KO\s*:|\[KO\]|\(KO\))/i.test(text) || strongText === 'KO') {
        el.setAttribute('data-lang-item', 'ko');
        if (strongText === 'KO') {
          if (strong && strong.nextSibling && strong.nextSibling.nodeType === Node.TEXT_NODE && strong.nextSibling.textContent) {
            strong.nextSibling.textContent = strong.nextSibling.textContent.replace(/^[\s:]+/, '');
          }
          strong?.remove();
        }
      } else if (/^(EN\s*:|\[EN\]|\(EN\))/i.test(text) || strongText === 'EN') {
        el.setAttribute('data-lang-item', 'en');
        if (strongText === 'EN') {
          if (strong && strong.nextSibling && strong.nextSibling.nodeType === Node.TEXT_NODE && strong.nextSibling.textContent) {
            strong.nextSibling.textContent = strong.nextSibling.textContent.replace(/^[\s:]+/, '');
          }
          strong?.remove();
        }
      }
    });

    const currentLang = postArticle.dataset.displayMode || 'all';
    document.documentElement.setAttribute('data-lang-mode', currentLang);
    postContent.classList.add(`mode-${currentLang}`);

  };

  initLanguageSwitcher();
</script>

