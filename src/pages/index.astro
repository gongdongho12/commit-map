---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { MapContainer } from '../components/map/MapContainer';

const allPosts = await getCollection('posts');
const posts = allPosts.filter(post => {
  // draft가 true인 경우 제외 (사용자 요청에 따라 항상 제외)
  if (post.data.draft) return false;
  return true;
});

// 각 포스트별 루트 데이터 (나라 정보 포함)
const routes = posts.map((post, index) => ({
  slug: post.id.replace(/\.md$/, ''),
  title: post.data.title,
  date: post.data.date,
  excerpt: post.data.excerpt,
  country: (post.data.countries && post.data.countries.length > 0) ? undefined : post.data.country,
  countries: post.data.countries || [post.data.country],
  locations: post.data.locations.map((loc, locIndex) => ({
    lat: loc.lat,
    lng: loc.lng,
    name: loc.name,
    slug: post.id.replace(/\.md$/, ''),
    country: loc.country || post.data.country,
    order: loc.order ?? locIndex + 1,
    note: loc.note,
    type: loc.type,
    // Add country from location or fallback to post country if single country post
    country: loc.country || (post.data.countries?.length ? undefined : post.data.country),
  })),
}));

// 날짜순 정렬
const sortedPosts = [...posts].sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 나라별 카운트
const countryCounts = posts.reduce((acc, post) => {
  // Combine primary and secondary countries, then split hyphen-separated entries
  // Prioritize countries list if available, otherwise use single country
  const targetCountries = (post.data.countries && post.data.countries.length > 0)
    ? post.data.countries
    : [post.data.country];
    
  const allCountries = targetCountries
    .filter(Boolean)
    .flatMap(c => c.split('-').map(s => s.trim()));
  allCountries.forEach(c => {
    if (c) acc[c] = (acc[c] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const currentYear = new Date().getFullYear();
const totalTravelDays = posts.reduce((acc, post) => {
  const startDate = post.data.date;
  const endDate = post.data.endDate || startDate;
  return acc + Math.ceil((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)) + 1;
}, 0);
const totalLocations = posts.reduce((acc, post) => acc + post.data.locations.length, 0);
const currentYearTrips = posts.filter(post => post.data.date.getFullYear() === currentYear).length;

// 여행 유형 아이콘
const tripTypes: Record<string, string> = {
  sightseeing: '🏛️',
  healing: '🧘',
  food: '🍽️',
  culture: '🎭',
  nature: '🌲',
  adventure: '⛰️',
  shopping: '🛍️',
  business: '💼',
  family: '👨‍👩‍👧‍👦',
  solo: '🚶',
};
---

<BaseLayout title="홈">
  <section class="hero">
    <h1>여행의 발자취</h1>
    <p>마크다운으로 기록하고, 지도에서 다시 만나다</p>
  </section>

  <section class="stats-section" aria-label="여행 요약">
    <div class="stat-item">
      <span class="stat-label">전체 여행</span>
      <strong>{posts.length}</strong>
    </div>
    <div class="stat-item">
      <span class="stat-label">방문 국가</span>
      <strong>{Object.keys(countryCounts).length}</strong>
    </div>
    <div class="stat-item">
      <span class="stat-label">기록 장소</span>
      <strong>{totalLocations}</strong>
    </div>
    <div class="stat-item">
      <span class="stat-label">여행일</span>
      <strong>{totalTravelDays}</strong>
    </div>
    <div class="stat-item">
      <span class="stat-label">올해 여행</span>
      <strong id="current-year-trips" data-fallback-year={currentYear}>{currentYearTrips}</strong>
    </div>
  </section>

  <!-- 나라별 태그 클라우드 -->
  <section class="tag-section">
    <div class="tag-cloud" id="country-filters">
      <button class="country-tag active" data-country="all">
        전체
      </button>
      {Object.entries(countryCounts)
        .sort((a, b) => b[1] - a[1])
        .map(([country, count]) => (
            <button class="country-tag" data-country={country}>
              {country} <span class="count">{count}</span>
            </button>
        ))}
    </div>

    <div class="filter-info" id="filter-info" style="display:none;">
      <span id="filter-label"></span>
      <button id="clear-filter">✕ 전체 보기</button>
    </div>
  </section>

  <section class="map-section">
    <div id="map-wrapper">
      <MapContainer 
        client:only="react" 
        locations={[]} 
        routes={routes} 
        worldView={true} 
      />
    </div>
  </section>

  <section class="posts-section plans-section" id="plans-section" hidden>
    <h2>🗓️ 여행 계획</h2>
    <div class="posts-grid" id="plans-grid"></div>
  </section>

  <section class="posts-section">
    <h2>✈️ 최근 여행</h2>
    <div class="posts-grid" id="posts-grid">
      {sortedPosts.map(post => {
        const countries = (post.data.countries && post.data.countries.length > 0) 
          ? post.data.countries 
          : (post.data.country ? [post.data.country] : []);
        
        // 여행 기간 계산
        const startDate = post.data.date;
        const endDate = post.data.endDate || startDate;
        const days = Math.ceil((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)) + 1;
        const nights = days - 1;
        const durationText = nights > 0 ? `${nights}박 ${days}일` : '당일치기';
        
        return (
          <a 
            href={`/posts/${post.id.replace(/\.md$/, '')}/`} 
            class="post-card-link trip-card" 
            data-countries={countries.join(',')}
            data-start={startDate.toISOString().slice(0, 10)}
            data-end={endDate.toISOString().slice(0, 10)}
          >
            <article class="post-card">
              <div class="post-card-header">
                <span class="post-country">{post.data.country}</span>
                <span class="dday-badge" data-dday-badge hidden></span>
              </div>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' })}
                {post.data.endDate && post.data.endDate.getTime() !== post.data.date.getTime() 
                  ? ` ~ ${post.data.endDate.toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' })}` 
                  : ''}
                <span class="duration-badge">{durationText}</span>
              </time>
              <h3>{post.data.title}</h3>
              {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
              <div class="post-meta">
                <span class="location-count">📍 {post.data.locations.length}개 장소</span>
                {post.data.tripType?.map(type => (
                  <span class="trip-type">{tripTypes[type]}</span>
                ))}
              </div>
              {post.data.tags && (
                <div class="post-tags">
                  {post.data.tags.slice(0, 4).map(tag => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
            </article>
          </a>
        );
      })}
    </div>
    <div class="load-more" id="recent-load-more" hidden aria-live="polite">
      <div class="load-more-status">
        <span id="recent-count-info"></span>
      </div>
      <span class="load-more-progress" aria-hidden="true">
        <span></span>
      </span>
      <button type="button" id="recent-more" hidden>더 보기</button>
    </div>
  </section>
</BaseLayout>

<script>
  let activeCountries = [];
  let visibleRecentCount = 3;
  const recentBatchSize = 3;
  const recentLoadDelayMs = 650;
  let recentLoadObserver = null;
  let isLoadingMoreRecent = false;
  let recentLoadTimeoutId = null;

  function parseLocalDate(value) {
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day);
  }

  function getTodayStart() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    return today;
  }

  function updateTripDateState() {
    const plansSection = document.getElementById('plans-section');
    const plansGrid = document.getElementById('plans-grid');
    const postsGrid = document.getElementById('posts-grid');
    if (!plansSection || !plansGrid || !postsGrid) return;

    const today = getTodayStart();
    const cards = Array.from(document.querySelectorAll('.trip-card'));
    const futureCards = [];
    const pastCards = [];

    cards.forEach(card => {
      const startValue = card.getAttribute('data-start');
      const endValue = card.getAttribute('data-end') || startValue;
      if (!startValue || !endValue) return;

      const startDate = parseLocalDate(startValue);
      const endDate = parseLocalDate(endValue);
      const dDay = Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      const isCurrent = startDate <= today && today <= endDate;
      const isPlanned = today <= endDate;
      const badge = card.querySelector('[data-dday-badge]');
      const article = card.querySelector('.post-card');

      if (badge) {
        if (isPlanned) {
          badge.hidden = false;
          badge.textContent = isCurrent ? '여행 중' : (dDay === 0 ? 'D-Day!' : `D-${dDay}`);
        } else {
          badge.hidden = true;
          badge.textContent = '';
        }
      }

      card.classList.toggle('plan-card-link', isPlanned);
      article?.classList.toggle('plan-card', isPlanned);

      if (isPlanned) {
        futureCards.push(card);
      } else {
        pastCards.push(card);
      }
    });

    futureCards.sort((a, b) => {
      return parseLocalDate(a.getAttribute('data-start')).getTime() - parseLocalDate(b.getAttribute('data-start')).getTime();
    });
    pastCards.sort((a, b) => {
      return parseLocalDate(b.getAttribute('data-start')).getTime() - parseLocalDate(a.getAttribute('data-start')).getTime();
    });

    futureCards.forEach(card => plansGrid.appendChild(card));
    pastCards.forEach(card => postsGrid.appendChild(card));
    plansSection.hidden = futureCards.length === 0;
  }

  function updateRecentList() {
    const postsGrid = document.getElementById('posts-grid');
    const loadMore = document.getElementById('recent-load-more');
    const countInfo = document.getElementById('recent-count-info');
    const moreBtn = document.getElementById('recent-more');
    if (!postsGrid || !loadMore || !countInfo || !moreBtn) return;

    const cards = Array.from(postsGrid.querySelectorAll('.trip-card'));
    const visibleCards = cards.filter(card => card.getAttribute('data-filter-match') !== 'false');
    visibleRecentCount = Math.min(Math.max(visibleRecentCount, recentBatchSize), visibleCards.length || recentBatchSize);

    cards.forEach(card => {
      card.style.display = 'none';
    });

    visibleCards.forEach((card, index) => {
      card.style.display = index < visibleRecentCount ? 'block' : 'none';
    });

    const shownCount = Math.min(visibleRecentCount, visibleCards.length);
    const remainingCount = Math.max(visibleCards.length - shownCount, 0);
    loadMore.hidden = remainingCount === 0;
    loadMore.classList.toggle('is-loading', isLoadingMoreRecent);
    moreBtn.textContent = `더 보기 (${remainingCount}개 남음)`;
    countInfo.textContent = isLoadingMoreRecent
      ? '다음 여행 불러오는 중...'
      : (remainingCount > 0 ? `${shownCount} / ${visibleCards.length}` : '');
  }

  function cancelRecentAutoLoad() {
    if (recentLoadTimeoutId) {
      window.clearTimeout(recentLoadTimeoutId);
      recentLoadTimeoutId = null;
    }

    isLoadingMoreRecent = false;
  }

  function revealMoreRecent() {
    visibleRecentCount += recentBatchSize;
    updateRecentList();
  }

  function queueRevealMoreRecent() {
    if (isLoadingMoreRecent) return;

    isLoadingMoreRecent = true;
    updateRecentList();

    recentLoadTimeoutId = window.setTimeout(() => {
      recentLoadTimeoutId = null;
      revealMoreRecent();
      isLoadingMoreRecent = false;
      updateRecentList();
      handleRecentAutoLoad();
    }, recentLoadDelayMs);
  }

  function handleRecentAutoLoad() {
    const loadMore = document.getElementById('recent-load-more');
    if (!loadMore || loadMore.hidden) return;

    const markerTop = loadMore.getBoundingClientRect().top;
    if (markerTop <= window.innerHeight + 240) {
      queueRevealMoreRecent();
    }
  }

  function setupRecentAutoLoad() {
    const loadMore = document.getElementById('recent-load-more');
    const moreBtn = document.getElementById('recent-more');
    if (!loadMore || !moreBtn) return;

    moreBtn.hidden = true;

    if ('IntersectionObserver' in window) {
      recentLoadObserver = new IntersectionObserver((entries) => {
        const shouldLoad = entries.some(entry => entry.isIntersecting);
        if (shouldLoad) queueRevealMoreRecent();
      }, {
        rootMargin: '0px 0px 240px 0px',
        threshold: 0.01,
      });

      recentLoadObserver.observe(loadMore);
    }

    window.addEventListener('scroll', handleRecentAutoLoad, { passive: true });
    window.addEventListener('resize', handleRecentAutoLoad);
    handleRecentAutoLoad();
  }

  function updateCurrentYearStats() {
    const currentYearTrips = document.getElementById('current-year-trips');
    if (!currentYearTrips) return;

    const year = new Date().getFullYear();
    const cards = Array.from(document.querySelectorAll('.trip-card'));
    const tripCount = cards.filter(card => {
      const startValue = card.getAttribute('data-start');
      return startValue ? parseLocalDate(startValue).getFullYear() === year : false;
    }).length;

    currentYearTrips.textContent = String(tripCount);
    currentYearTrips.setAttribute('data-fallback-year', String(year));
  }

  function applyFilters() {
    cancelRecentAutoLoad();

    // Filter posts (consider all associated countries, split hyphen-separated)
    // Cast to NodeListOf<HTMLElement> to access style property
    const cards = document.querySelectorAll('.post-card-link');
    let visiblePlanCount = 0;
    cards.forEach(card => {
      // @ts-ignore
      const raw = card.dataset.countries?.split(',') || [];
      const countries = raw.flatMap(c => c.split('-').map(s => s.trim()));
      const matches = activeCountries.length === 0 || activeCountries.some(ac => countries.includes(ac));
      card.setAttribute('data-filter-match', matches ? 'true' : 'false');
      if (card.parentElement?.id === 'plans-grid') {
        // @ts-ignore
        card.style.display = matches ? 'block' : 'none';
        if (matches) visiblePlanCount++;
      }
    });

    const plansSection = document.getElementById('plans-section');
    const plansGrid = document.getElementById('plans-grid');
    if (plansSection && plansGrid) {
      plansSection.hidden = plansGrid.children.length === 0 || visiblePlanCount === 0;
    }

    updateRecentList();

    // Notify Map Component
    window.dispatchEvent(new CustomEvent('map-filter-change', {
        detail: { countries: [...activeCountries] }
    }));

    // Update filter info UI
    const filterInfo = document.getElementById('filter-info');
    const filterLabel = document.getElementById('filter-label');
    if (filterInfo && filterLabel) {
        if (activeCountries.length > 0) {
        filterInfo.style.display = 'flex';
        filterLabel.textContent = `🌍 ${activeCountries.join(' + ')} 여행만 표시 중`;
        } else {
        filterInfo.style.display = 'none';
        }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateCurrentYearStats();
    updateTripDateState();
    applyFilters();

    // Country tag click handling (max 2 selections)
    document.querySelectorAll('.country-tag').forEach(btn => {
      btn.addEventListener('click', () => {
        const country = btn.getAttribute('data-country');
        if (!country) return;
        if (country === 'all') {
          // Clear all filters
          activeCountries = [];
          document.querySelectorAll('.country-tag').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          visibleRecentCount = recentBatchSize;
          applyFilters();
          return;
        }
        document.querySelector('[data-country="all"]')?.classList.remove('active');
        const idx = activeCountries.indexOf(country);
        if (idx > -1) {
          activeCountries.splice(idx, 1);
        } else            
            if (!activeCountries.includes(country)) {
              activeCountries.push(country);
            }
        // toggle button active class
        btn.classList.toggle('active', activeCountries.includes(country));
        if (activeCountries.length === 0) {
          document.querySelector('[data-country="all"]')?.classList.add('active');
        }
        visibleRecentCount = recentBatchSize;
        applyFilters();
      });
    });

    // Clear filter button
    const clearBtn = document.getElementById('clear-filter');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        activeCountries = [];
        // remove active class from all buttons
        document.querySelectorAll('.country-tag').forEach(b => b.classList.remove('active'));
        document.querySelector('[data-country="all"]')?.classList.add('active');
        visibleRecentCount = recentBatchSize;
        applyFilters();
      });
    }

    document.getElementById('recent-more')?.addEventListener('click', revealMoreRecent);
    setupRecentAutoLoad();
  });
</script>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #4361ee, #7b2cbf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .tag-section {
    margin-bottom: 1.5rem;
  }

  .stats-section {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 auto 1.5rem;
  }

  .stat-item {
    display: flex;
    min-width: 0;
    min-height: 86px;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-secondary);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
  }

  .stat-label {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .stat-item strong {
    color: var(--color-text);
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .country-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    background: #e0f2fe;
    color: #0369a1;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-family: inherit;
  }

  .country-tag:hover, .country-tag.active {
    background: #0ea5e9;
    color: white;
  }

  .country-tag .count {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .filter-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background: #fef3c7;
    border-radius: 8px;
    font-size: 0.875rem;
    color: #92400e;
  }

  .filter-info button {
    background: transparent;
    border: none;
    color: #92400e;
    cursor: pointer;
    font-size: 0.8rem;
    text-decoration: underline;
  }

  .map-section {
    margin-bottom: 2rem;
  }

  #map-wrapper {
    height: 500px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .posts-section {
    padding: 2rem;
    background: var(--color-bg-secondary);
    border-radius: 16px;
    margin-bottom: 2rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .posts-section h2 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    font-weight: 600;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-border);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .post-card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .post-card {
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.2s;
    border: 1px solid var(--color-border);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(67, 97, 238, 0.12);
    border-color: var(--color-primary);
  }

  .post-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
  }

  .post-country {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .post-card time {
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .duration-badge {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .post-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .post-excerpt {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: auto;
  }

  .location-count {
    background: #f1f5f9;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .trip-type {
    font-size: 1rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .load-more {
    display: flex;
    flex-direction: column;
    align-items: center;
