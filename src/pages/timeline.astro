---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const rawPosts = await getCollection('posts');
const isHiddenPost = (post: typeof rawPosts[number]) => (
  post.data.visibility === 'hidden'
);
const isDraftPost = (post: typeof rawPosts[number]) => Boolean(post.data.draft);
const posts = rawPosts.filter(post => {
  if (isHiddenPost(post)) return false;
  return true;
});

// 날짜순 정렬
const allPosts = [...posts].sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 나라별 통계
const countryCounts = posts.reduce((acc, post) => {
  const targetCountries = (post.data.countries && post.data.countries.length > 0)
    ? post.data.countries
    : [post.data.country];

  targetCountries.forEach(c => {
    if (c) acc[c] = (acc[c] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

// 여행 유형별 통계
const tripTypes: Record<string, { icon: string; label: string }> = {
  sightseeing: { icon: '🏛️', label: '관광' },
  healing: { icon: '🧘', label: '힐링' },
  food: { icon: '🍽️', label: '맛집' },
  culture: { icon: '🎭', label: '문화' },
  nature: { icon: '🌲', label: '자연' },
  adventure: { icon: '⛰️', label: '모험' },
  shopping: { icon: '🛍️', label: '쇼핑' },
  business: { icon: '💼', label: '출장' },
  family: { icon: '👨‍👩‍👧‍👦', label: '가족' },
  solo: { icon: '🚶', label: '혼행' },
};

const tripTypeCounts = posts.reduce((acc, post) => {
  post.data.tripType?.forEach(type => {
    acc[type] = (acc[type] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const months = ['1월', '2월', '3월', '4월', '5월', '6월', 
                '7월', '8월', '9월', '10월', '11월', '12월'];
---

<BaseLayout title="타임라인">
  <div class="timeline-page">
    <aside class="sidebar">
      <section class="filter-section">
        <h3>🌍 나라별 <button class="clear-btn" id="clear-country">초기화</button></h3>
        <div class="tag-cloud" id="country-filters">
          {Object.entries(countryCounts)
            .sort((a, b) => b[1] - a[1])
            .map(([country, count]) => (
              <button class="filter-tag country-tag" data-filter-type="country" data-filter-value={country}>
                {country} <span class="count">{count}</span>
              </button>
            ))}
        </div>
      </section>

      <section class="filter-section">
        <h3>✈️ 여행 유형 <button class="clear-btn" id="clear-type">초기화</button></h3>
        <div class="tag-cloud" id="type-filters">
          {Object.entries(tripTypeCounts).map(([type, count]) => (
            <button class="filter-tag type-tag" data-filter-type="tripType" data-filter-value={type}>
              {tripTypes[type]?.icon} {tripTypes[type]?.label}
              <span class="count">{count}</span>
            </button>
          ))}
        </div>
      </section>

      <section class="stats-section">
        <h3>📊 통계</h3>
        <div class="stats">
          <div class="stat-item">
            <span class="stat-value">{posts.length}</span>
            <span class="stat-label">여행</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{Object.keys(countryCounts).length}</span>
            <span class="stat-label">나라</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{posts.reduce((sum, p) => sum + p.data.locations.length, 0)}</span>
            <span class="stat-label">장소</span>
          </div>
        </div>
      </section>

      <div class="active-filters" id="active-filters" style="display:none;">
        <h3>🔍 적용된 필터</h3>
        <div id="filter-badges"></div>
      </div>
    </aside>

    <main class="timeline-main">
      <h1>🗓️ 여행 타임라인</h1>
      
      <div id="posts-container">
        {allPosts.map((post, index) => {
          const isDraft = isDraftPost(post);
          const year = new Date(post.data.date).getFullYear();
          const prevYear = index > 0 ? new Date(allPosts[index - 1].data.date).getFullYear() : null;
          const showYear = year !== prevYear;

          const month = new Date(post.data.date).getMonth();
          const monthKey = `${year}-${String(month + 1).padStart(2, '0')}`;
          const prevPostDate = index > 0 ? new Date(allPosts[index - 1].data.date) : null;
          const prevMonthKey = prevPostDate 
            ? `${prevPostDate.getFullYear()}-${String(prevPostDate.getMonth() + 1).padStart(2, '0')}`
            : null;
          const showMonth = monthKey !== prevMonthKey;
          const countries = (post.data.countries && post.data.countries.length > 0) 
            ? post.data.countries 
            : (post.data.country ? [post.data.country] : []);
          const types = post.data.tripType || [];
          const startDate = post.data.date;
          const endDate = post.data.endDate || startDate;

          return (
            <>
              {showYear && (
                <div class="timeline-year-divider">
                  <h2>{year}</h2>
                </div>
              )}
              {showMonth && (
                <div class="timeline-month-divider" data-period-divider>
                  <span>{year}년 {months[month]}</span>
                </div>
              )}
              <a href={`/posts/${post.id.replace(/\.md$/, '')}/`} 
                 class={`timeline-card${isDraft ? ' draft-card' : ''}`}
                 data-year={year}
                 data-countries={countries.join(',')}
                 data-types={types.join(',')}
                 data-start={startDate.toISOString().slice(0, 10)}
                 data-end={endDate.toISOString().slice(0, 10)}
                 data-visibility={post.data.visibility || 'public'}>
                <div class="timeline-date">
                  <span class="month">{months[month]}</span>
                  <span class="day">{new Date(post.data.date).getDate()}</span>
                </div>
                <div class="timeline-content">
                  <div class="timeline-header">
                    <span class="country-badge">{post.data.country}</span>
                    {isDraft && <span class="draft-badge">작업중</span>}
                    <span class="dday-badge" data-dday-badge hidden></span>
                    {post.data.tripType?.map(type => (
                      <span class="type-badge">
                        {tripTypes[type]?.icon}
                      </span>
                    ))}
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                  <div class="timeline-meta">
                    <span>🗓️ {post.data.date.toLocaleDateString('ko-KR')}{post.data.endDate ? ` ~ ${post.data.endDate.toLocaleDateString('ko-KR')}` : ''}</span>
                    <span>📍 {post.data.locations.length}개 장소</span>
                    {post.data.tags?.slice(0, 3).map(tag => (
                      <span class="mini-tag">#{tag}</span>
                    ))}
                  </div>
                </div>
              </a>
            </>
          );
        })}
      </div>

      <div id="no-results" style="display:none;">
        <p>필터 조건에 맞는 여행이 없습니다.</p>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // 필터 상태
  let activeCountry: string | null = null;
  let activeType: string | null = null;

  // 요소들
  const countryFilters = document.querySelectorAll('[data-filter-type="country"]');
  const typeFilters = document.querySelectorAll('[data-filter-type="tripType"]');
  const cards = document.querySelectorAll('.timeline-card') as NodeListOf<HTMLElement>;
  const activeFiltersSection = document.getElementById('active-filters')!;
  const filterBadges = document.getElementById('filter-badges')!;
  const noResults = document.getElementById('no-results')!;
  const clearCountryBtn = document.getElementById('clear-country')!;
  const clearTypeBtn = document.getElementById('clear-type')!;

  function parseLocalDate(value: string) {
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day);
  }

  function updateRelativeDateBadges() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    cards.forEach(card => {
      const startValue = card.dataset.start;
      const endValue = card.dataset.end || startValue;
      if (!startValue || !endValue) return;

      const startDate = parseLocalDate(startValue);
      const endDate = parseLocalDate(endValue);
      const dDay = Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      const isCurrent = startDate <= today && today <= endDate;
      const isPlanned = today <= endDate;
      const badge = card.querySelector('[data-dday-badge]') as HTMLElement | null;

      card.classList.toggle('future-plan', isPlanned);
      if (badge) {
        if (isPlanned) {
          badge.hidden = false;
          badge.textContent = isCurrent ? '여행 중' : (dDay === 0 ? 'D-Day!' : `D-${dDay}`);
        } else {
          badge.hidden = true;
          badge.textContent = '';
        }
      }
    });
  }

  function updateDividerVisibility() {
    const dividers = document.querySelectorAll('.timeline-year-divider, .timeline-month-divider') as NodeListOf<HTMLElement>;

    dividers.forEach(divider => {
      let node = divider.nextElementSibling;
      let hasVisibleCard = false;
      const stopAtMonth = divider.classList.contains('timeline-month-divider');

      while (
        node &&
        !node.classList.contains('timeline-year-divider') &&
        !(stopAtMonth && node.classList.contains('timeline-month-divider'))
      ) {
        if (node.classList.contains('timeline-card')) {
          const card = node as HTMLElement;
          if (card.style.display !== 'none') {
            hasVisibleCard = true;
            break;
          }
        }
        node = node.nextElementSibling;
      }

      divider.style.display = hasVisibleCard ? 'flex' : 'none';
    });
  }

  function applyFilters() {
    let visibleCount = 0;
    
    cards.forEach(card => {
      const countries = card.dataset.countries?.split(',') || [];
      const types = card.dataset.types?.split(',') || [];
      
      const matchesCountry = !activeCountry || countries.includes(activeCountry);
      const matchesType = !activeType || types.includes(activeType);
      
      if (matchesCountry && matchesType) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // 결과 없음 표시
    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    updateDividerVisibility();

    // 활성 필터 표시
    updateActiveFiltersUI();
  }

  function updateActiveFiltersUI() {
    const hasFilters = activeCountry || activeType;
    activeFiltersSection.style.display = hasFilters ? 'block' : 'none';
    
    if (hasFilters) {
      let badges = '';
      if (activeCountry) {
        badges += `<span class="filter-badge country-badge-active">${activeCountry} ✕</span>`;
      }
      if (activeType) {
        const typeInfo = {
          sightseeing: '🏛️ 관광', healing: '🧘 힐링', food: '🍽️ 맛집',
          culture: '🎭 문화', nature: '🌲 자연', adventure: '⛰️ 모험',
          shopping: '🛍️ 쇼핑', business: '💼 출장', family: '👨‍👩‍👧‍👦 가족', solo: '🚶 혼행'
        };
        badges += `<span class="filter-badge type-badge-active">${typeInfo[activeType as keyof typeof typeInfo]} ✕</span>`;
      }
      filterBadges.innerHTML = badges;
    }

    // 버튼 활성 상태 업데이트
    countryFilters.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-filter-value') === activeCountry);
    });
    typeFilters.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-filter-value') === activeType);
    });
  }

  // 나라 필터 클릭
  countryFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const value = btn.getAttribute('data-filter-value');
      activeCountry = activeCountry === value ? null : value;
      applyFilters();
    });
  });

  // 유형 필터 클릭
  typeFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const value = btn.getAttribute('data-filter-value');
      activeType = activeType === value ? null : value;
      applyFilters();
    });
  });

  // 초기화 버튼
  clearCountryBtn.addEventListener('click', () => {
    activeCountry = null;
    applyFilters();
  });
  clearTypeBtn.addEventListener('click', () => {
    activeType = null;
    applyFilters();
  });

  // 활성 필터 배지 클릭으로 제거
  filterBadges.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('country-badge-active')) {
      activeCountry = null;
    } else if (target.classList.contains('type-badge-active')) {
      activeType = null;
    }
    applyFilters();
  });

  updateRelativeDateBadges();
  applyFilters();
</script>

<style>
  .timeline-page {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .timeline-page {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .sidebar {
      order: 1;
      position: static;
    }
  }

  .sidebar {
    position: sticky;
    top: 80px;
    height: fit-content;
  }

  .filter-section, .stats-section, .active-filters {
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1rem;
    border: 1px solid var(--color-border);
  }

  .filter-section h3, .stats-section h3, .active-filters h3 {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .clear-btn {
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    border-radius: 4px;
  }

  .clear-btn:hover {
    background: var(--color-border);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border-radius: 20px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-family: inherit;
  }

  .country-tag {
    background: #e0f2fe;
    color: #0369a1;
  }

  .country-tag:hover, .country-tag.active {
    background: #0ea5e9;
    color: white;
  }

  .type-tag {
    background: #fce7f3;
    color: #be185d;
  }

  .type-tag:hover, .type-tag.active {
    background: #ec4899;
    color: white;
  }

  .count {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    text-align: center;
  }

  .stat-item {
    padding: 0.5rem;
  }

  .stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  #filter-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-badge {
    padding: 0.375rem 0.625rem;
    border-radius: 20px;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .country-badge-active {
    background: #0ea5e9;
    color: white;
  }

  .type-badge-active {
    background: #ec4899;
    color: white;
  }

  .timeline-main h1 {
    font-size: 1.75rem;
    margin-bottom: 2rem;
  }

  #posts-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .timeline-card {
    display: flex;
    gap: 1rem;
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    transition: all 0.2s;
  }

  .timeline-card:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 20px rgba(67, 97, 238, 0.1);
    border-color: var(--color-primary);
  }

  .timeline-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 70px;
    padding-right: 1rem;
    border-right: 2px solid var(--color-border);
  }

  .timeline-date .year {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .timeline-date .month {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .timeline-date .day {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .timeline-content {
    flex: 1;
  }

  .timeline-header {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .country-badge {
    font-size: 0.75rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .dday-badge {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    animation: pulse 2s infinite;
  }

  .timeline-card.future-plan {
    border-left: 4px solid #f59e0b;
    background: linear-gradient(to right, rgba(254, 243, 199, 0.3), var(--color-bg-secondary));
  }

  .timeline-card.draft-card {
    border-color: #cbd5e1;
    background: linear-gradient(to right, rgba(226, 232, 240, 0.75), var(--color-bg-secondary));
    color: #475569;
  }

  .timeline-card.draft-card.future-plan {
    border-left-color: #64748b;
  }

  .timeline-card.draft-card:hover {
    border-color: #64748b;
    box-shadow: 0 4px 20px rgba(100, 116, 139, 0.14);
  }

  .timeline-card.draft-card .country-badge {
    background: #64748b;
  }

  .timeline-card.draft-card .timeline-date .day {
    color: #475569;
  }

  .draft-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0.2rem 0.5rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #e2e8f0;
    color: #475569;
    font-size: 0.75rem;
    font-weight: 800;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .type-badge {
    font-size: 1rem;
  }

  .timeline-content h3 {
    font-size: 1.1rem;
    margin-bottom: 0.375rem;
  }

  .timeline-content p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .mini-tag {
    color: var(--color-accent);
  }

  #no-results {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-muted);
  }

  .timeline-year-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin: 3rem 0 0.5rem;
    padding: 0;
  }

  #posts-container > .timeline-year-divider:first-child {
    margin-top: 0;
  }

  .timeline-year-divider::before,
  .timeline-year-divider::after {
    content: '';
    flex: 1;
    height: 2px;
    background: var(--color-border);
    border-radius: 2px;
  }

  .timeline-year-divider h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
    opacity: 1;
    font-family: var(--font-sans);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .timeline-month-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .timeline-month-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .timeline-month-divider span {
    padding: 0.25rem 0.625rem;
    background: #f1f5f9;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .timeline-main h1 {
      font-size: 1.45rem;
      margin-bottom: 1.25rem;
    }

    .filter-section, .stats-section, .active-filters {
      padding: 1rem;
      border-radius: 10px;
    }

    .filter-section .tag-cloud {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      -webkit-overflow-scrolling: touch;
    }

    .filter-tag {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .stats {
      gap: 0.25rem;
    }

    .stat-item {
      padding: 0.25rem;
    }

    .timeline-card {
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 10px;
    }

    .timeline-card:hover {
      transform: none;
    }

    .timeline-date {
      min-width: 54px;
      padding-right: 0.75rem;
    }

    .timeline-date .month {
      font-size: 0.7rem;
    }

    .timeline-date .day {
      font-size: 1.35rem;
    }

